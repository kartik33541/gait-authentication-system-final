# Frontend Vite config reads env files from the repo root or frontend directory
VITE_ML_API_URL=https://kartik33541-gaitauth-backend.hf.space
VITE_ML_GATEWAY_KEY=GAIT_SECURE_2026

# Backend Flask Gateway & Security
GAIT_API_KEY=GAIT_SECURE_2026
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://kartik33541-gaitauth-backend.hf.space
PORT=8000

# Kenny AI Assistant (Google Gemini - Dual-Key Automatic Rotation Pool)
VITE_GEMINI_API_KEY=your_primary_gemini_api_key_here
VITE_GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key_here
VITE_USE_AZURE_OPENAI=false

# Cloud Firestore Credentials
FIREBASE_SERVICE_ACCOUNT_PATH=production/secrets/firebase-service-account.json

# Email Dispatcher Service (Gmail SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_app_password_here
SMTP_SENDER_NAME="GaitAuth Smart Access"
