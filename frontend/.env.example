# GaitAuth Frontend Environment Configuration Template
# Set your deployed cloud or local backend URL
VITE_ML_API_URL=https://your-backend-api.hf.space
VITE_ML_GATEWAY_KEY=your_gateway_key_here

# Kenny AI Assistant (Google Gemini - Dual-Key Automatic Rotation Pool)
VITE_GEMINI_API_KEY=your_primary_gemini_api_key_here
VITE_GEMINI_API_KEY_BACKUP=your_backup_gemini_api_key_here

# OpenAI Switch (Keep false to use resilient Gemini dual-key pool in production)
VITE_USE_AZURE_OPENAI=false

# Optional Legacy Fallbacks
# VITE_AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# VITE_AZURE_OPENAI_API_KEY=your_azure_openai_api_key_here
# VITE_AZURE_OPENAI_API_VERSION=2025-03-01-preview
# VITE_AZURE_OPENAI_DEPLOYMENT=gpt-5.4-nano


# Firebase Client Configuration (Cloud Firestore / Auth)
VITE_FIREBASE_API_KEY=your_firebase_web_api_key_here
VITE_FIREBASE_PROJECT_ID=your_firebase_project_id_here
